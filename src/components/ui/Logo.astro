---
/**
 * Kiberstol — фирменный логотип.
 *
 * Знак — растровый логотип из `src/assets/logo.png` (генерируется
 * `scripts/generate-brand-assets.mjs` из `downloads/kiberlogo.png`).
 * Astro оптимизирует его через `astro:assets` (WebP, srcset для Retina).
 * Бренд берётся из `site/settings.yaml`.
 *
 * Пропсы:
 *  - withWordmark: показывать ли текстовую часть «KiberStol»
 *  - size: высота знака в px
 *  - priority: загружать сразу (для логотипа в шапке)
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import logo from '../../assets/logo.png';

interface Props {
  withWordmark?: boolean;
  size?: number;
  priority?: boolean;
}

const { withWordmark = true, size = 32, priority = false } = Astro.props;

const settings = await getEntry('site', 'settings');
const brand = settings!.data.brand;

// Сохраняем пропорции исходного знака (857×696).
const logoWidth = Math.round(size * (logo.width / logo.height));
---

<a
  href="/"
  class="inline-flex items-center gap-2"
  aria-label={`${brand} — на главную`}
>
  <Image
    src={logo}
    alt=""
    width={logoWidth}
    height={size}
    densities={[1, 2]}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    class="shrink-0"
  />

  {
    withWordmark && (
      <span class="text-lg font-bold leading-none tracking-tight">
        Kiber<span class="text-accent">Stol</span>
      </span>
    )
  }
</a>
