---
/**
 * LegalBlock — обязательные сведения ИП (закон РБ, §4.2 ТЗ).
 * Размещается в самом низу футера. Данные — из `site/settings.yaml`.
 *
 * Место жительства ИП НЕ указывается (требование ТЗ).
 */
import { getEntry } from 'astro:content';

const settings = await getEntry('site', 'settings');
const s = settings!.data;
const l = s.labels;

// Способы оплаты/доставки теперь редактируются в секции «Доставка и оплата»
// (коллекция `sections`), а не в настройках сайта.
const delivery = await getEntry('sections', 'delivery');
const deliveryValue = delivery?.data.variant.value as
  | { paymentMethods?: string[]; deliveryMethods?: string[] }
  | undefined;
const paymentMethods = deliveryValue?.paymentMethods ?? [];
const deliveryMethods = deliveryValue?.deliveryMethods ?? [];
---

<section class="border-t border-border py-6 text-xs text-muted" aria-label="Сведения о продавце">
  <div class="mx-auto max-w-6xl space-y-2 px-4">
    <p>
      <span class="font-semibold text-text">{s.fullName}</span>
      {s.unp && <> · УНП {s.unp}</>}
      {s.registrationDate && <> · зарегистрирован {s.registrationDate}</>}
    </p>
    {s.legalAddress && (
      <p>{l?.legalAddress ?? 'Юридический адрес'}: {s.legalAddress}</p>
    )}
    <p>
      {s.tradeRegistryNumber && (
        <>Сведения о включении в торговый реестр: № {s.tradeRegistryNumber}</>
      )}
      {s.tradeRegistryDate && <> от {s.tradeRegistryDate}</>}
    </p>
    <p>
      {s.phone && (
        <a href={`tel:${s.phone.replace(/[^+\d]/g, '')}`} class="hover:text-text">
          {s.phone}
        </a>
      )}
      {s.email && (
        <>
          {' · '}
          <a href={`mailto:${s.email}`} class="hover:text-text">
            {s.email}
          </a>
        </>
      )}
    </p>
    {s.workHours && <p>{l?.workHours ?? 'Режим работы'}: {s.workHours}</p>}
    {s.complaintsBookAddress && (
      <p>
        {l?.complaintsBookAddress ?? 'Книга замечаний и предложений'}: {s.complaintsBookAddress}
      </p>
    )}
    {s.pickupAddress && (
      <p>{l?.pickupAddress ?? 'Пункт выдачи'}: {s.pickupAddress}</p>
    )}
    {s.authorizedBody && (
      <p>
        {l?.authorizedBody ?? 'Уполномоченный рассматривать обращения покупателей'}: {s.authorizedBody}
      </p>
    )}
    {s.authorizedBodyPhone && (
      <p>
        {l?.authorizedBodyPhone ?? 'Телефоны местного исполнительного органа'}: {s.authorizedBodyPhone}
      </p>
    )}
    {paymentMethods.length > 0 && (
      <p>{l?.paymentMethods ?? 'Способы оплаты'}: {paymentMethods.join('; ')}</p>
    )}
    {deliveryMethods.length > 0 && (
      <p>{l?.deliveryMethods ?? 'Способы и сроки доставки'}: {deliveryMethods.join('; ')}</p>
    )}
  </div>
</section>