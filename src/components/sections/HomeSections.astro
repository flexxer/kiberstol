---
/**
 * HomeSections — рендерер секций главной страницы.
 *
 * Принимает массив секций (уже отсортированных по `order`) и динамические
 * данные (`lines`, `products`, `faq`, `settings`), маппит `type` секции на
 * соответствующий секционный компонент.
 *
 * Секции задаются в CMS (Keystatic, коллекция `sections`), порядок — полем
 * `order`. Движок не содержит ни контента, ни стилей.
 */
import HeroSection from './HeroSection.astro';
import CatalogSection from './CatalogSection.astro';
import AdvantagesSection from './AdvantagesSection.astro';
import DeliverySection from './DeliverySection.astro';
import OrderSection from './OrderSection.astro';
import FaqSection from './FaqSection.astro';
import ContactSection from './ContactSection.astro';

type Block = {
  discriminant: string;
  value: Record<string, unknown>;
};

interface Section {
  id: string;
  body?: string;
  data: {
    heading: string;
    content?: Block[];
    variant: {
      discriminant: string;
      value?: Record<string, unknown> | null | undefined;
    };
  };
}

interface Props {
  sections: Section[];
  lines: any[];
  products: any[];
}

const { sections, lines, products } = Astro.props;
---

{
  sections.map((section) => {
    const { heading, content, variant } = section.data;
    const type = variant.discriminant;
    const value = variant.value ?? {};
    // markdown-тело секции лежит в `section.body` (contentField), а не в `data`.
    const body = section.body;

    switch (type) {
      case 'hero':
        return (
          <HeroSection
            heading={heading}
            subheading={value.subheading as string | undefined}
            ctaText={value.ctaText as string | undefined}
            ctaHref={value.ctaHref as string | undefined}
            video={value.video as boolean | undefined}
            body={body}
            content={content}
          />
        );
      case 'catalog':
        return (
          <CatalogSection
            heading={heading}
            subheading={value.subheading as string | undefined}
            body={body}
            ctaText={value.ctaText as string | undefined}
            ctaHref={value.ctaHref as string | undefined}
            lines={lines}
            content={content}
          />
        );
      case 'advantages':
        return <AdvantagesSection heading={heading} content={content} />;
      case 'delivery':
        return (
          <DeliverySection
            heading={heading}
            body={body}
            paymentMethods={(value.paymentMethods as string[] | undefined) ?? []}
            deliveryMethods={(value.deliveryMethods as string[] | undefined) ?? []}
            content={content}
          />
        );
      case 'order':
        return (
          <OrderSection
            heading={heading}
            body={body}
            ctaText={value.ctaText as string | undefined}
            ctaHref={value.ctaHref as string | undefined}
            content={content}
          />
        );
      case 'faq':
        return (
          <FaqSection
            heading={heading}
            items={(value.items as { question: string; answer: string }[] | undefined) ?? []}
            content={content}
          />
        );
      case 'contact':
        return <ContactSection heading={heading} body={body} content={content} />;
      default:
        return null;
    }
  })
}