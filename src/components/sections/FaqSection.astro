---
/**
 * FaqSection — секция `faq` главной страницы.
 * Заголовок + аккордеон через блок `Faq.astro` (данные из коллекции `faq`).
 */
import Faq from '../blocks/Faq.astro';

interface Props {
  heading?: string;
  items: { question: string; answer: string }[];
}

const { heading = 'Частые вопросы', items } = Astro.props;
---

{
  items.length > 0 && (
    <section id="faq" class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="mb-6 text-2xl font-bold text-text">{heading}</h2>
      <Faq items={items} />
    </section>
  )
}