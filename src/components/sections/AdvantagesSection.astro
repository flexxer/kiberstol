---
/**
 * AdvantagesSection — секция `advantages` главной страницы.
 * Заголовок + гибкие контент-блоки (columns/banner/richText) через
 * `ContentBlocks.astro`.
 */
import ContentBlocks from '../blocks/ContentBlocks.astro';

type Block = {
  type: string;
  [key: string]: unknown;
};

interface Props {
  heading?: string;
  content?: Block[];
}

const { heading = 'Почему Kiberstol', content } = Astro.props;
---

<section id="advantages" class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="mb-6 text-2xl font-bold text-text">{heading}</h2>
    {content && content.length > 0 && <ContentBlocks blocks={content} />}
  </div>
</section>