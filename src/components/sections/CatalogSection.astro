---
/**
 * CatalogSection — секция `catalog` главной страницы.
 * Каталог: только линейки (баннеры). Модели — на странице линейки.
 * Данные приходят из коллекции `lines`.
 */
import Banner from '../blocks/Banner.astro';
import RichText from '../blocks/RichText.astro';
import ContentBlocks from '../blocks/ContentBlocks.astro';

type Block = {
  discriminant: string;
  value: Record<string, unknown>;
};

interface Line {
  id: string;
  data: {
    title: string;
    image?: string;
  };
  body?: string;
}

interface Props {
  heading: string;
  subheading?: string;
  body?: string;
  ctaText?: string;
  ctaHref?: string;
  lines: Line[];
  content?: Block[];
}

const { heading, subheading, body, ctaText, ctaHref, lines, content } = Astro.props;
---

<section id="catalog" class="mx-auto max-w-6xl px-4 py-12">
  <h2 class="mb-4 text-2xl font-bold text-text">{heading}</h2>
  {subheading && <p class="mb-4 max-w-3xl text-muted">{subheading}</p>}
  {body && (
    <div class="mb-6 max-w-3xl">
      <RichText content={body} />
    </div>
  )}
  <div class="space-y-6">
    {
      lines.map((line) => (
        <Banner
          image={line.data.image}
          heading={line.data.title}
          text={line.body}
          href={`/lines/${line.id}`}
          gradient="right"
        />
      ))
    }
  </div>
  {ctaText && ctaHref && (
    <div class="mt-8">
      <a
        href={ctaHref}
        class="inline-block rounded bg-primary px-6 py-3 font-semibold text-bg transition hover:opacity-90"
      >
        {ctaText}
      </a>
    </div>
  )}
  {content && content.length > 0 && (
    <div class="mt-8">
      <ContentBlocks blocks={content} />
    </div>
  )}
</section>