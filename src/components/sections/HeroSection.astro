---
/**
 * HeroSection — секция `hero` главной страницы.
 * Переиспользует блок `Hero.astro` (заголовок, подзаголовок, CTA, видео)
 * и `RichText.astro` для markdown-вводного текста.
 */
import Hero from '../blocks/Hero.astro';
import RichText from '../blocks/RichText.astro';
import ContentBlocks from '../blocks/ContentBlocks.astro';

type Block = {
  discriminant: string;
  value: Record<string, unknown>;
};

interface Props {
  heading: string;
  subheading?: string;
  ctaText?: string;
  ctaHref?: string;
  video?: boolean;
  body?: string;
  content?: Block[];
}

const { heading, subheading, ctaText, ctaHref, video = false, body, content } =
  Astro.props;
---

<Hero
  heading={heading}
  subheading={subheading}
  ctaText={ctaText}
  ctaHref={ctaHref}
  video={video}
/>
{body && (
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <RichText content={body} />
  </div>
)}
{content && content.length > 0 && (
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <ContentBlocks blocks={content} />
  </div>
)}