---
/**
 * Video — inline-видео с контролами.
 * Постер оптимизируется через `astro:assets`.
 */
import { getImage } from 'astro:assets';
import { resolveImage } from '../../lib/image';

interface Props {
  src: string;
  poster?: string;
  controls?: boolean;
  autoplay?: boolean;
}

const { src, poster, controls = true, autoplay = false } = Astro.props;

const resolvedPoster = resolveImage(poster);
const optimizedPoster = resolvedPoster
  ? await getImage({ src: resolvedPoster, width: 1200, format: 'webp' })
  : undefined;
---

<video
  src={src}
  poster={optimizedPoster?.src}
  controls={controls}
  autoplay={autoplay}
  playsinline
  class="w-full rounded border border-border"
/>