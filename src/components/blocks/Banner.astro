---
/**
 * Banner — промо-баннер «важный момент».
 */
interface Props {
  image?: string;
  heading: string;
  text?: string;
  href?: string;
}

const { image, heading, text, href } = Astro.props;
---

<div class="relative overflow-hidden rounded border border-border bg-surface">
  {
    image && (
      <img
        src={image}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover opacity-20"
        loading="lazy"
      />
    )
  }
  <div class="relative px-6 py-8">
    <h2 class="text-xl font-bold text-text">{heading}</h2>
    {text && <p class="mt-2 text-muted">{text}</p>}
    {
      href && (
        <a
          href={href}
          class="mt-4 inline-block font-semibold text-primary hover:underline"
        >
          Подробнее →
        </a>
      )
    }
  </div>
</div>