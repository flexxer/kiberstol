---
/**
 * Hero — баннер-заголовок страницы.
 * Заголовок, подзаголовок, опциональное фоновое изображение и CTA.
 * Оптимизация фонового изображения через `astro:assets`.
 *
 * Опциональный проп `video` включает фоновый видеоролик «комната геймера»
 * (WebM/MP4 + постер) с тонирующей маской в фирменных цветах.
 */
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/image';

interface Props {
  heading: string;
  subheading?: string;
  image?: string;
  ctaText?: string;
  ctaHref?: string;
  video?: boolean;
}

const { heading, subheading, image, ctaText, ctaHref, video = false } = Astro.props;

const resolved = resolveImage(image);
---

<section class="relative overflow-hidden border-b border-border bg-surface">
  {
    video && (
      <div class="hero-video" aria-hidden="true">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/assets/hero-poster.jpg"
        >
          <source src="/assets/hero.webm" type="video/webm" />
          <source src="/assets/hero.mp4" type="video/mp4" />
        </video>
        <div class="hero-video-color"></div>
        <div class="hero-video-tint"></div>
      </div>
    )
  }
  {
    resolved && (
      <Image
        src={resolved}
        alt=""
        aria-hidden="true"
        width={1600}
        format="webp"
        class="absolute inset-0 h-full w-full object-cover opacity-20"
        loading="eager"
      />
    )
  }
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:py-24">
    <h1 class="max-w-3xl text-3xl font-bold leading-tight text-text sm:text-5xl">
      {heading}
    </h1>
    {
      subheading && (
        <p class="mt-4 max-w-2xl text-lg text-muted">{subheading}</p>
      )
    }
    {
      ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="mt-8 inline-block rounded bg-primary px-6 py-3 font-semibold text-bg transition hover:opacity-90"
        >
          {ctaText}
        </a>
      )
    }
  </div>
</section>