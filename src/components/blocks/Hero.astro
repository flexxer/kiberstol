---
/**
 * Hero — баннер-заголовок страницы.
 * Заголовок, подзаголовок, опциональное фоновое изображение и CTA.
 */
interface Props {
  heading: string;
  subheading?: string;
  image?: string;
  ctaText?: string;
  ctaHref?: string;
}

const { heading, subheading, image, ctaText, ctaHref } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border bg-surface">
  {
    image && (
      <img
        src={image}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover opacity-20"
        loading="eager"
      />
    )
  }
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:py-24">
    <h1 class="max-w-3xl text-3xl font-bold leading-tight text-text sm:text-5xl">
      {heading}
    </h1>
    {
      subheading && (
        <p class="mt-4 max-w-2xl text-lg text-muted">{subheading}</p>
      )
    }
    {
      ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="mt-8 inline-block rounded bg-primary px-6 py-3 font-semibold text-bg transition hover:opacity-90"
        >
          {ctaText}
        </a>
      )
    }
  </div>
</section>