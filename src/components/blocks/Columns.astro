---
/**
 * Columns — многоколоночный блок.
 *
 * Каждая колонка содержит заголовок и вложенный массив блоков (`content`),
 * который рендерится через `ContentBlocks.astro`. Это позволяет размещать
 * внутри колонки текст, изображения, кнопки и другие leaf-блоки.
 */
import ContentBlocks from './ContentBlocks.astro';

type Block = {
  discriminant: string;
  value: Record<string, unknown>;
};

interface Props {
  columns: { heading?: string; content?: Block[] }[];
}

const { columns } = Astro.props;
---

<div
  class={`grid gap-6 ${columns.length > 1 ? 'md:grid-cols-2' : ''} ${columns.length > 2 ? 'lg:grid-cols-3' : ''}`}
>
  {
    columns.map((col) => (
      <div class="rounded border border-border bg-surface p-5">
        {col.heading && <h3 class="mb-2 font-semibold text-text">{col.heading}</h3>}
        {col.content && col.content.length > 0 && <ContentBlocks blocks={col.content} />}
      </div>
    ))
  }
</div>
