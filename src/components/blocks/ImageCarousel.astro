---
/**
 * ImageCarousel — карусель изображений (слайдер).
 * Интерактив подключается в Фазе 5 (`carousel.ts`).
 */
interface Props {
  images: { image: string; alt: string; caption?: string }[];
  autoplay?: boolean;
}

const { images, autoplay = false } = Astro.props;
---

<div
  class="carousel relative overflow-hidden rounded border border-border"
  data-autoplay={autoplay ? 'true' : 'false'}
>
  <div class="carousel-track flex transition-transform">
    {
      images.map((img, i) => (
        <figure class="carousel-slide w-full shrink-0">
          <img
            src={img.image}
            alt={img.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            class="h-full w-full object-cover"
          />
          {
            img.caption && (
              <figcaption class="p-3 text-center text-sm text-muted">
                {img.caption}
              </figcaption>
            )
          }
        </figure>
      ))
    }
  </div>

  {
    images.length > 1 && (
      <>
        <button
          type="button"
          class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 rounded bg-bg/70 p-2 text-text"
          aria-label="Предыдущий слайд"
        >
          ‹
        </button>
        <button
          type="button"
          class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 rounded bg-bg/70 p-2 text-text"
          aria-label="Следующий слайд"
        >
          ›
        </button>
      </>
    )
  }
</div>