---
/**
 * HeroScene.astro — декоративная SVG-сцена «комната геймера».
 *
 * Тёмная комната со столом, монитором и игровым системным блоком.
 * Сцена отрисована с перспективой, тенями, бликами и реалистичной
 * крыльчаткой вентиляторов (7 изогнутых лопастей + ступица).
 *
 * Подсветка вентиляторов управляется скриптом `hero.ts` через
 * CSS-переменную `--fan-hue` (hsl). Вращение лопастей — чистый CSS.
 *
 * Сцена декоративная: `aria-hidden="true"`, не несёт смысловой нагрузки.
 */
---

<svg
  class="hero-scene"
  viewBox="0 0 1200 600"
  xmlns="http://www.w3.org/2000/svg"
  role="presentation"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    <!-- Фон комнаты: тёмный, с неоновым свечением сверху -->
    <radialGradient id="room-glow" cx="50%" cy="22%" r="85%">
      <stop offset="0%" stop-color="#0d1428" />
      <stop offset="55%" stop-color="#070b18" />
      <stop offset="100%" stop-color="#02030a" />
    </radialGradient>

    <!-- Пол: лёгкий градиент к горизонту -->
    <linearGradient id="floor-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0a0f1e" />
      <stop offset="100%" stop-color="#04060d" />
    </linearGradient>

    <!-- Тень (мягкая, под объектами) -->
    <radialGradient id="shadow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="rgba(0,0,0,0.55)" />
      <stop offset="70%" stop-color="rgba(0,0,0,0.25)" />
      <stop offset="100%" stop-color="rgba(0,0,0,0)" />
    </radialGradient>

    <!-- Столешница: свет сверху -->
    <linearGradient id="desk-top" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1a2440" />
      <stop offset="100%" stop-color="#0d1322" />
    </linearGradient>

    <!-- Корпус ПК: металл с бликом -->
    <linearGradient id="pc-case" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#0a0f1e" />
      <stop offset="45%" stop-color="#141c33" />
      <stop offset="100%" stop-color="#080c18" />
    </linearGradient>

    <!-- Стеклянная боковая панель: отражение -->
    <linearGradient id="glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="rgba(255,255,255,0.10)" />
      <stop offset="40%" stop-color="rgba(255,255,255,0.02)" />
      <stop offset="100%" stop-color="rgba(255,255,255,0.06)" />
    </linearGradient>

    <!-- Свечение монитора -->
    <radialGradient id="monitor-glow" cx="50%" cy="50%" r="55%">
      <stop offset="0%" stop-color="rgba(0, 212, 255, 0.30)" />
      <stop offset="100%" stop-color="rgba(0, 212, 255, 0)" />
    </radialGradient>

    <!-- Подсветка вентилятора: цвет через --fan-hue -->
    <radialGradient id="fan-glow">
      <stop offset="0%" stop-color="hsl(var(--fan-hue, 190) 100% 62% / 0.95)" />
      <stop offset="55%" stop-color="hsl(var(--fan-hue, 190) 100% 50% / 0.40)" />
      <stop offset="100%" stop-color="hsl(var(--fan-hue, 190) 100% 50% / 0)" />
    </radialGradient>

    <!-- Лопасть вентилятора: изогнутая, с бликом -->
    <linearGradient id="blade-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="hsl(var(--fan-hue, 190) 100% 78%)" />
      <stop offset="45%" stop-color="hsl(var(--fan-hue, 190) 100% 60%)" />
      <stop offset="100%" stop-color="hsl(var(--fan-hue, 190) 100% 42%)" />
    </linearGradient>

    <!-- Одна изогнутая лопасть (символ, вращается через CSS) -->
    <path
      id="blade"
      d="M0,-5
         C5,-5 9,-11 9,-22
         C9,-29 6,-33 2,-33
         C-2,-33 -4,-29 -4,-22
         C-4,-11 0,-5 0,-5 Z"
      fill="url(#blade-grad)"
    />

    <!-- Крыльчатка: 7 лопастей вокруг ступицы -->
    <g id="fan-impeller">
      <use href="#blade" />
      <use href="#blade" transform="rotate(51.43)" />
      <use href="#blade" transform="rotate(102.86)" />
      <use href="#blade" transform="rotate(154.29)" />
      <use href="#blade" transform="rotate(205.71)" />
      <use href="#blade" transform="rotate(257.14)" />
      <use href="#blade" transform="rotate(308.57)" />
    </g>
  </defs>

  <!-- Фон комнаты -->
  <rect width="1200" height="600" fill="url(#room-glow)" />

  <!-- Пол (нижняя часть, с перспективной сеткой) -->
  <rect x="0" y="430" width="1200" height="170" fill="url(#floor-grad)" />
  <g stroke="rgba(0, 212, 255, 0.05)" stroke-width="1">
    <line x1="0" y1="470" x2="1200" y2="470" />
    <line x1="0" y1="520" x2="1200" y2="520" />
    <line x1="0" y1="580" x2="1200" y2="580" />
    <line x1="200" y1="430" x2="80" y2="600" />
    <line x1="400" y1="430" x2="360" y2="600" />
    <line x1="600" y1="430" x2="600" y2="600" />
    <line x1="800" y1="430" x2="840" y2="600" />
    <line x1="1000" y1="430" x2="1120" y2="600" />
  </g>

  <!-- Неоновая полоса на стене -->
  <rect x="0" y="150" width="1200" height="2" fill="rgba(0, 212, 255, 0.12)" />

  <!-- ===== Тени под объектами ===== -->
  <ellipse cx="600" cy="452" rx="360" ry="26" fill="url(#shadow)" />
  <ellipse cx="600" cy="452" rx="150" ry="18" fill="url(#shadow)" />
  <ellipse cx="895" cy="452" rx="110" ry="20" fill="url(#shadow)" />

  <!-- ===== Стол (перспектива) ===== -->
  <g>
    <!-- Столешница: трапеция (шире спереди) -->
    <path
      d="M 220 400 L 980 400 L 1040 452 L 160 452 Z"
      fill="url(#desk-top)"
      stroke="#1c2740"
      stroke-width="2"
    />
    <!-- Передняя кромка столешницы -->
    <path d="M 160 452 L 1040 452 L 1040 462 L 160 462 Z" fill="#0a0f1e" />
    <!-- Ножки -->
    <path d="M 200 462 L 216 462 L 210 600 L 194 600 Z" fill="#0b1020" stroke="#1c2740" stroke-width="1.5" />
    <path d="M 984 462 L 1000 462 L 1006 600 L 990 600 Z" fill="#0b1020" stroke="#1c2740" stroke-width="1.5" />
  </g>

  <!-- ===== Монитор (лёгкий ракурс) ===== -->
  <g>
    <!-- Подставка -->
    <ellipse cx="600" cy="398" rx="70" ry="12" fill="#0b1020" stroke="#1c2740" stroke-width="2" />
    <path d="M 585 398 L 615 398 L 610 340 L 590 340 Z" fill="#0b1020" stroke="#1c2740" stroke-width="2" />
    <!-- Корпус монитора (трапеция для перспективы) -->
    <path
      d="M 470 150 L 730 150 L 742 300 L 458 300 Z"
      fill="#05070f"
      stroke="#2a3a5c"
      stroke-width="3"
    />
    <!-- Экран -->
    <path
      d="M 484 164 L 716 164 L 726 288 L 474 288 Z"
      fill="#04060d"
    />
    <!-- Свечение экрана -->
    <path d="M 484 164 L 716 164 L 726 288 L 474 288 Z" fill="url(#monitor-glow)" />
    <!-- Контент экрана (неоновые линии) -->
    <rect x="500" y="184" width="130" height="9" rx="4" fill="rgba(0, 212, 255, 0.55)" />
    <rect x="500" y="204" width="200" height="4" rx="2" fill="rgba(139, 92, 246, 0.45)" />
    <rect x="500" y="216" width="160" height="4" rx="2" fill="rgba(139, 92, 246, 0.30)" />
    <rect x="500" y="252" width="90" height="6" rx="3" fill="rgba(0, 212, 255, 0.35)" />
    <!-- Блик на экране -->
    <path d="M 500 164 L 560 164 L 520 288 L 484 288 Z" fill="rgba(255,255,255,0.03)" />
  </g>

  <!-- ===== Системный блок (башня с боковым стеклом) ===== -->
  <g>
    <!-- Корпус (трапеция: верх чуть уже) -->
    <path
      d="M 820 250 L 970 250 L 982 360 L 808 360 Z"
      fill="url(#pc-case)"
      stroke="#2a3a5c"
      stroke-width="3"
    />
    <!-- Верхняя грань (перспектива) -->
    <path d="M 820 250 L 970 250 L 962 240 L 828 240 Z" fill="#1a2440" stroke="#2a3a5c" stroke-width="2" />

    <!-- Боковое стекло -->
    <path
      d="M 830 262 L 960 262 L 970 350 L 820 350 Z"
      fill="#0a0f1e"
      stroke="#1c2740"
      stroke-width="1.5"
    />
    <!-- Отражение на стекле -->
    <path d="M 830 262 L 960 262 L 970 350 L 820 350 Z" fill="url(#glass)" />

    <!-- Вентилятор 1 (верхний) -->
    <g class="fan" transform="translate(862, 288)">
      <circle r="34" fill="url(#fan-glow)" class="fan-glow" />
      <circle r="34" fill="none" stroke="#1c2740" stroke-width="2.5" />
      <circle r="26" fill="#05070f" />
      <g class="fan-blades">
        <use href="#fan-impeller" />
      </g>
      <!-- Ступица с бликом -->
      <circle r="7" fill="hsl(var(--fan-hue, 190) 100% 60%)" />
      <circle r="3" cx="-1.5" cy="-1.5" fill="rgba(255,255,255,0.5)" />
    </g>

    <!-- Вентилятор 2 (средний) -->
    <g class="fan" transform="translate(895, 288)">
      <circle r="34" fill="url(#fan-glow)" class="fan-glow" />
      <circle r="34" fill="none" stroke="#1c2740" stroke-width="2.5" />
      <circle r="26" fill="#05070f" />
      <g class="fan-blades">
        <use href="#fan-impeller" />
      </g>
      <circle r="7" fill="hsl(var(--fan-hue, 190) 100% 60%)" />
      <circle r="3" cx="-1.5" cy="-1.5" fill="rgba(255,255,255,0.5)" />
    </g>

    <!-- Вентилятор 3 (нижний) -->
    <g class="fan" transform="translate(928, 288)">
      <circle r="34" fill="url(#fan-glow)" class="fan-glow" />
      <circle r="34" fill="none" stroke="#1c2740" stroke-width="2.5" />
      <circle r="26" fill="#05070f" />
      <g class="fan-blades">
        <use href="#fan-impeller" />
      </g>
      <circle r="7" fill="hsl(var(--fan-hue, 190) 100% 60%)" />
      <circle r="3" cx="-1.5" cy="-1.5" fill="rgba(255,255,255,0.5)" />
    </g>

    <!-- Кнопка питания -->
    <circle cx="895" cy="342" r="4" fill="rgba(0, 212, 255, 0.7)" />
    <circle cx="895" cy="342" r="7" fill="none" stroke="rgba(0, 212, 255, 0.3)" stroke-width="1" />
  </g>

  <!-- ===== Клавиатура (перспектива) ===== -->
  <g>
    <path
      d="M 470 340 L 650 340 L 660 366 L 460 366 Z"
      fill="#0b1020"
      stroke="#1c2740"
      stroke-width="2"
    />
    <path d="M 478 346 L 642 346 L 650 360 L 470 360 Z" fill="#111831" />
    <!-- Ряды клавиш -->
    <g fill="#1a2440">
      <rect x="484" y="349" width="150" height="3" rx="1" />
      <rect x="484" y="354" width="150" height="3" rx="1" />
    </g>
  </g>

  <!-- ===== Мышь ===== -->
  <g>
    <ellipse cx="700" cy="352" rx="16" ry="24" fill="#0b1020" stroke="#1c2740" stroke-width="2" />
    <ellipse cx="700" cy="352" rx="16" ry="24" fill="url(#glass)" />
    <line x1="700" y1="336" x2="700" y2="344" stroke="rgba(0, 212, 255, 0.4)" stroke-width="2" />
  </g>
</svg>