---
/**
 * ContentBlocks — рендер массива гибких блоков контента.
 *
 * Маппинг `type` блока → Astro-компонент. Используется на generic-страницах
 * линеек (`/lines/[slug]`) и моделей (`/products/[slug]`), а также в любых
 * местах, где контент строится из `contentBlocks` (см. `content.config.ts`).
 *
 * Блоки задаются в CMS (Keystatic, `fields.blocks`), внешний вид — в CSS.
 * Движок не содержит ни контента, ни стилей.
 */
import Hero from './Hero.astro';
import RichText from './RichText.astro';
import Image from './Image.astro';
import ImageCarousel from './ImageCarousel.astro';
import Video from './Video.astro';
import VideoGif from './VideoGif.astro';
import Gallery from './Gallery.astro';
import Cta from './Cta.astro';
import Faq from './Faq.astro';
import Specs from './Specs.astro';
import Banner from './Banner.astro';
import Columns from './Columns.astro';
import Quote from './Quote.astro';
import Divider from './Divider.astro';

type Block = {
  discriminant: string;
  value: Record<string, unknown>;
};

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---

<div class="space-y-8">
  {
    blocks.map((block) => {
      const v = block.value;
      switch (block.discriminant) {
        case 'hero':
          return (
            <Hero
              heading={v.heading as string}
              subheading={v.subheading as string | undefined}
              image={v.image as string | undefined}
              ctaText={v.ctaText as string | undefined}
              ctaHref={v.ctaHref as string | undefined}
            />
          );
        case 'richText':
          return <RichText content={v.content as string} />;
        case 'image':
          return (
            <Image
              image={v.image as string}
              alt={v.alt as string}
              caption={v.caption as string | undefined}
              align={v.align as 'left' | 'center' | 'right' | undefined}
            />
          );
        case 'imageCarousel':
          return (
            <ImageCarousel
              images={v.images as { image: string; alt: string; caption?: string }[]}
              autoplay={v.autoplay as boolean | undefined}
            />
          );
        case 'video':
          return (
            <Video
              src={v.src as string}
              poster={v.poster as string | undefined}
              controls={v.controls as boolean | undefined}
              autoplay={v.autoplay as boolean | undefined}
            />
          );
        case 'videoGif':
          return (
            <VideoGif
              src={v.src as string}
              poster={v.poster as string | undefined}
            />
          );
        case 'gallery':
          return (
            <Gallery
              images={v.images as { image: string; alt: string; caption?: string }[]}
            />
          );
        case 'cta':
          return (
            <Cta
              text={v.text as string}
              href={v.href as string}
              style={v.style as 'primary' | 'secondary' | 'outline' | undefined}
            />
          );
        case 'faq':
          return (
            <Faq items={v.items as { question: string; answer: string }[]} />
          );
        case 'specs':
          return (
            <Specs items={v.items as { name: string; value: string }[]} />
          );
        case 'banner':
          return (
            <Banner
              image={v.image as string | undefined}
              heading={v.heading as string}
              text={v.text as string | undefined}
              href={v.href as string | undefined}
            />
          );
        case 'columns':
          return (
            <Columns
              columns={v.columns as { heading?: string; content?: Block[] }[]}
            />
          );
        case 'quote':
          return (
            <Quote
              text={v.text as string}
              author={v.author as string | undefined}
            />
          );
        case 'divider':
          return <Divider style={v.style as 'line' | 'space' | undefined} />;
        default:
          return null;
      }
    })
  }
</div>