---
type AvailabilityStatus = 'in_stock' | 'out_of_stock' | 'preorder';

interface Props {
  name: string;
  description?: string;
  price?: number;
  currency?: string;
  url?: string;
  image?: string;
  brand?: string;
  countryOfOrigin?: string;
  sku?: string;
  /** Статус наличия из CMS; маппится в schema.org availability. */
  availabilityStatus?: AvailabilityStatus;
  /** Готовый schema.org availability URL; приоритетнее статуса. */
  availability?: string;
  /** schema.org itemCondition URL; по умолчанию — NewCondition. */
  itemCondition?: string;
}

/** Маппинг статуса наличия в schema.org. */
const AVAILABILITY_URLS: Record<AvailabilityStatus, string> = {
  in_stock: 'https://schema.org/InStock',
  out_of_stock: 'https://schema.org/OutOfStock',
  preorder: 'https://schema.org/PreOrder',
};

const {
  name,
  description,
  price,
  currency = 'BYN',
  url,
  image,
  brand,
  countryOfOrigin,
  sku,
  availabilityStatus,
  availability: availabilityUrl,
  itemCondition = 'https://schema.org/NewCondition',
} = Astro.props;

const availability =
  availabilityUrl ??
  (availabilityStatus ? AVAILABILITY_URLS[availabilityStatus] : AVAILABILITY_URLS.in_stock);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  ...(description && { description }),
  ...(url && { url }),
  ...(image && { image }),
  ...(sku && { sku }),
  ...(brand && { brand: { '@type': 'Brand', name: brand } }),
  ...(countryOfOrigin && {
    countryOfOrigin: { '@type': 'Country', name: countryOfOrigin },
  }),
  ...(price !== undefined && {
    offers: {
      '@type': 'Offer',
      price,
      priceCurrency: currency,
      availability,
      itemCondition,
      ...(url && { url }),
    },
  }),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />