---
/**
 * 404.astro — брендированная страница «не найдено».
 * Статическая, noindex, без записи в sitemap.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const settings = await getEntry('site', 'settings');
const brand = settings?.data.brand ?? 'Kiberstol';
const labels = settings?.data.labels;

const title = `Страница не найдена — ${brand}`;
const description = 'Запрошенная страница не существует или была перемещена.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="mx-auto flex max-w-3xl flex-col items-start px-4 py-20">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary">404</p>
    <h1 data-reveal="up" class="mb-4 text-3xl font-bold text-text sm:text-4xl">
      Страница не найдена
    </h1>
    <p class="mb-8 max-w-xl text-muted">
      Возможно, ссылка устарела или в адресе опечатка. Вернитесь на главную или откройте
      каталог — там все линейки и модели.
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="rounded border border-primary bg-primary px-5 py-2.5 text-sm font-semibold text-bg transition hover:opacity-90"
      >
        {labels?.breadcrumbsHome ?? 'На главную'}
      </a>
      <a
        href="/products"
        class="rounded border border-border px-5 py-2.5 text-sm font-semibold text-text transition hover:border-primary hover:text-primary"
      >
        {labels?.catalogTitle ?? 'Каталог'}
      </a>
    </div>
  </section>
</BaseLayout>
