---
/**
 * index.astro — главная страница.
 *
 * Секции управляются из CMS (коллекция `sections`): порядок — полем `order`,
 * тип — полем `type`. Рендер — через `HomeSections.astro`, который маппит
 * `type` на секционный компонент.
 *
 * Все тексты, реквизиты и SEO берутся из CMS (`site/settings.yaml`,
 * `sections/*.md`, `lines/*.md`, `products/*.md`, `faq/*.md`).
 * Движок не содержит ни контента, ни стилей.
 *
 * JSON-LD рендерится переиспользуемыми компонентами `seo/jsonld/*`
 * через слот `head` (см. BaseLayout.astro).
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/sections/HomeSections.astro';
import Organization from '../components/seo/jsonld/Organization.astro';
import ItemList from '../components/seo/jsonld/ItemList.astro';
import FaqPage from '../components/seo/jsonld/FaqPage.astro';

// Единый источник правды: реквизиты и глобальный SEO — из `site/settings.yaml`.
const settings = await getEntry('site', 'settings');
const s = settings!.data;

// Секции главной — из коллекции `sections`, сортировка по `order`.
const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Каталог: линейки и модели (вложенность линейка → модели).
const lines = (await getCollection('lines')).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const brand = s.brand;
const tagline = s.tagline;
const seoTitle = s.seo?.title ?? `${brand} — ${tagline}`;
const seoDescription = s.seo?.description ?? tagline;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kiberstol.by';

// Соцпрофили для `Organization.sameAs` (только заданные в CMS).
const sameAs = [s.viber, s.instagram].filter((url): url is string => Boolean(url));

// FAQ-элементы для секции `faq` (вопрос → ответ) — из варианта секции.
const faqSection = sections.find((s) => s.data.variant.discriminant === 'faq');
const faqItems: { question: string; answer: string }[] =
  (faqSection?.data.variant.value as { items?: { question: string; answer: string }[] } | undefined)?.items ??
  [];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  noindex={s.seo?.noindex}
  type="website"
>
  <Organization
    slot="head"
    name={s.fullName}
    unp={s.unp}
    url={siteUrl}
    logo={`${siteUrl}/favicon.svg`}
    telephone={s.phone}
    email={s.email}
    address={s.address}
    sameAs={sameAs}
  />
  <ItemList
    slot="head"
    items={lines.map((line, i) => ({
      name: line.data.title,
      url: `${siteUrl}/lines/${line.id}`,
      position: i + 1,
    }))}
  />
  <FaqPage slot="head" items={faqItems} />

  <HomeSections
    sections={sections}
    lines={lines}
    products={products}
  />
</BaseLayout>