---
/**
 * index.astro — главная страница.
 *
 * Секции управляются из CMS (коллекция `sections`): порядок — полем `order`,
 * тип — полем `type`. Рендер — через `HomeSections.astro`, который маппит
 * `type` на секционный компонент.
 *
 * Все тексты, реквизиты и SEO берутся из CMS (`site/settings.md`,
 * `sections/*.md`, `lines/*.md`, `products/*.md`, `faq/*.md`).
 * Движок не содержит ни контента, ни стилей.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/sections/HomeSections.astro';

// Единый источник правды: реквизиты и глобальный SEO — из `site/settings.md`.
const settings = await getEntry('site', 'settings');
const s = settings?.data;

// Секции главной — из коллекции `sections`, сортировка по `order`.
const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Каталог: линейки и модели (вложенность линейка → модели).
const lines = (await getCollection('lines')).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

// FAQ — вопросы-ответы (аккордеон).
const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

const brand = s?.brand ?? 'Kiberstol.by';
const tagline = s?.tagline ?? 'Игровые компьютерные столы';
const seoTitle = s?.seo?.title ?? `${brand} — ${tagline}`;
const seoDescription = s?.seo?.description ?? tagline;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kiberstol.by';

// JSON-LD: Organization (реквизиты ИП) + ItemList (каталог) + FAQPage.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: s?.fullName ?? brand,
  ...(s?.unp && { taxID: s.unp }),
  url: siteUrl,
  ...(s?.phone && { telephone: s.phone }),
  ...(s?.email && { email: s.email }),
  ...(s?.address && {
    address: { '@type': 'PostalAddress', streetAddress: s.address },
  }),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: lines.map((line, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: line.data.title,
    url: `${siteUrl}/lines/${line.id}`,
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.data.question,
    acceptedAnswer: { '@type': 'Answer', text: item.body },
  })),
};

// FAQ-элементы для секции `faq` (вопрос → ответ).
const faqItems = faq.map((item) => ({
  question: item.data.question,
  answer: item.body ?? '',
}));
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  type="website"
  jsonLd={[organizationJsonLd, itemListJsonLd, faqJsonLd]}
>
  <HomeSections
    sections={sections}
    lines={lines}
    products={products}
    faq={faqItems}
    paymentMethods={s?.paymentMethods}
    deliveryMethods={s?.deliveryMethods}
  />
</BaseLayout>