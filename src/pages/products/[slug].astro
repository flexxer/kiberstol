---
/**
 * products/[slug].astro — карточка модели (generic).
 *
 * Содержит юридически обязательные поля карточки товара (закон РБ, §5 ТЗ):
 * наименование, изготовитель (+местонахождение), поставщик, страна
 * происхождения, гарантия, цена (BYN), признак б/у. Плюс продающие поля:
 * фото, галерея, характеристики, бейдж, кнопка заказа.
 *
 * Гибкие блоки контента рендерятся через `ContentBlocks.astro`.
 */
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentBlocks from '../../components/blocks/ContentBlocks.astro';
import Specs from '../../components/blocks/Specs.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Product from '../../components/seo/jsonld/Product.astro';
import BreadcrumbList from '../../components/seo/jsonld/BreadcrumbList.astro';
import { resolveImage } from '../../lib/image';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const p = product.data;

const lines = await getCollection('lines');
const line = lines.find((l) => l.id === p.line);

// Товары той же линейки (для мини-карточек), исключая текущий.
const relatedProducts = (await getCollection('products'))
  .filter((rp) => rp.data.line === p.line && rp.id !== product.id)
  .sort((a, b) => a.data.order - b.data.order);

const settings = await getEntry('site', 'settings');
const brand = settings!.data.brand;
const labels = settings!.data.labels;

const title = p.seo?.title ?? p.title;
const description = p.seo?.description ?? p.shortDescription;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kiberstol.by';
const productUrl = `${siteUrl}/products/${product.id}`;

// Галерея: главное фото + миниатюры (для кликабельной галереи).
const galleryImages = [
  ...(p.image ? [{ src: p.image, alt: p.title }] : []),
  ...(p.gallery ?? []).map((src, i) => ({ src, alt: `${p.title} — фото ${i + 1}` })),
];

// Оптимизированные URL для главного фото и миниатюр.
// Ширина/высота передаются в `<img>` для предотвращения layout shift (CLS).
const mainImage = resolveImage(p.image);
const mainImageUrl = mainImage
  ? (await getImage({ src: mainImage, width: 1200, format: 'webp' })).src
  : undefined;
const mainImageHeight = mainImage
  ? Math.round((1200 * mainImage.height) / mainImage.width)
  : undefined;
const productImageUrl = mainImageUrl;

const thumbnails = await Promise.all(
  galleryImages.map(async (img) => {
    const resolved = resolveImage(img.src);
    if (!resolved) return null;
    const url = (await getImage({ src: resolved, width: 400, format: 'webp' })).src;
    const height = Math.round((400 * resolved.height) / resolved.width);
    return { ...img, url, width: 400, height };
  }),
);
const validThumbnails = thumbnails.filter((t): t is NonNullable<typeof t> => t !== null);
---

<BaseLayout
  title={title}
  description={description}
  image={p.image}
  imageAlt={p.title}
  noindex={p.seo?.noindex}
  type="product"
>
  <Product
    slot="head"
    name={p.title}
    description={description}
    price={p.price}
    url={productUrl}
    image={productImageUrl ? `${siteUrl}${productImageUrl}` : undefined}
    brand={brand}
    countryOfOrigin={p.countryOfOrigin}
    sku={product.id}
    availability="https://schema.org/InStock"
    itemCondition={p.used ? 'https://schema.org/UsedCondition' : 'https://schema.org/NewCondition'}
  />
  <BreadcrumbList
    slot="head"
    items={[
      { name: 'Главная', url: siteUrl },
      { name: 'Каталог', url: `${siteUrl}/products` },
      ...(line ? [{ name: line.data.title, url: `${siteUrl}/lines/${line.id}` }] : []),
      { name: p.title, url: productUrl },
    ]}
  />
  <section class="mx-auto max-w-6xl px-4 py-12">
    <Breadcrumbs
      items={[
        { name: labels?.breadcrumbsHome ?? 'Главная', url: '/' },
        { name: labels?.breadcrumbsCatalog ?? 'Каталог', url: '/products' },
        ...(line ? [{ name: line.data.title, url: `/lines/${line.id}` }] : []),
        { name: p.title },
      ]}
    />

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Фото и галерея -->
      <div class="product-gallery">
        {mainImageUrl && (
          <a
            href={mainImageUrl}
            class="product-gallery-lightbox group block overflow-hidden rounded border border-border"
          >
            <img
              src={mainImageUrl}
              alt={p.title}
              width="1200"
              height={mainImageHeight}
              class="product-gallery-main h-full w-full object-cover transition group-hover:scale-105"
            />
          </a>
        )}
        {validThumbnails.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-3">
            {validThumbnails.map((img) => (
              <button
                type="button"
                class="product-gallery-thumb overflow-hidden rounded border border-border transition hover:border-primary"
                data-src={img.url}
                data-alt={img.alt}
                aria-label={img.alt}
              >
                <img
                  src={img.url}
                  alt={img.alt}
                  width={img.width}
                  height={img.height}
                  loading="lazy"
                  class="h-20 w-full object-cover"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Основная информация + характеристики -->
      <div>
        {p.badge && (
          <span class="mb-2 inline-block rounded bg-secondary px-2 py-0.5 text-xs font-semibold text-bg">
            {p.badge}
          </span>
        )}
        <h1 class="text-3xl font-bold text-text">{p.title}</h1>
        {p.shortDescription && <p class="mt-2 text-muted">{p.shortDescription}</p>}

        <div class="mt-4 flex items-baseline gap-3">
          <span class="text-3xl font-bold text-primary">
            {p.price.toLocaleString('ru-BY')} BYN
          </span>
          {p.oldPrice && (
            <span class="text-lg text-muted line-through">
              {p.oldPrice.toLocaleString('ru-BY')} BYN
            </span>
          )}
        </div>

        {p.ctaText && (
          <a
            href="/#contacts"
            class="mt-6 inline-block rounded bg-primary px-6 py-3 font-semibold text-bg transition hover:opacity-90"
          >
            {p.ctaText}
          </a>
        )}

        {product.body && (
          <div class="prose prose-invert mt-6 max-w-none text-muted" set:html={renderMarkdown(product.body)} />
        )}

        <!-- Характеристики (справа от галереи в десктопе) -->
        {p.specs && p.specs.length > 0 && (
          <div class="mt-8">
            <h2 class="mb-3 text-lg font-bold text-text">{labels?.specs ?? 'Характеристики'}</h2>
            <Specs items={p.specs} />
          </div>
        )}
      </div>
    </div>

    <!-- Юридически обязательные сведения о товаре (аккордеон, скрыт по умолчанию) -->
    <div class="faq-item mt-10 rounded border border-border bg-surface">
      <button
        type="button"
        class="faq-question flex w-full items-center justify-between gap-4 px-4 py-3 text-left text-sm font-semibold text-text"
        aria-expanded="false"
        aria-controls="product-info"
      >
        <span>{labels?.productInfo ?? 'Сведения о товаре'}</span>
        <span class="faq-icon text-primary" aria-hidden="true">+</span>
      </button>
      <div id="product-info" class="faq-answer hidden px-4 pb-4">
        <dl class="space-y-1.5 text-xs">
          <div>
            <dt class="font-semibold text-text">Изготовитель</dt>
            <dd class="text-muted">{p.manufacturer}{p.manufacturerLocation ? `, ${p.manufacturerLocation}` : ''}</dd>
          </div>
          <div>
            <dt class="font-semibold text-text">Поставщик</dt>
            <dd class="text-muted">{p.supplier}</dd>
          </div>
          <div>
            <dt class="font-semibold text-text">Страна происхождения</dt>
            <dd class="text-muted">{p.countryOfOrigin}</dd>
          </div>
          {p.warranty && (
            <div>
              <dt class="font-semibold text-text">Гарантийный срок</dt>
              <dd class="text-muted">{p.warranty}</dd>
            </div>
          )}
          {p.used && (
            <div>
              <dt class="font-semibold text-text">Состояние</dt>
              <dd class="text-muted">Товар, бывший в употреблении</dd>
            </div>
          )}
        </dl>
      </div>
    </div>

    <!-- Гибкие блоки контента -->
    {p.content && p.content.length > 0 && (
      <div class="mt-10">
        <ContentBlocks blocks={p.content} />
      </div>
    )}

    <!-- Мини-карточки товаров той же линейки -->
    {relatedProducts.length > 0 && (
      <div class="mt-12">
        <h2 class="mb-4 text-2xl font-bold text-text">
          {labels?.relatedProducts ?? 'Другие модели линейки'}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedProducts.map((rp) => (
            <ProductCard product={rp} />
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>