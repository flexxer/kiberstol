---
/**
 * products/[slug].astro — карточка модели (generic).
 *
 * Содержит юридически обязательные поля карточки товара (закон РБ, §5 ТЗ):
 * наименование, изготовитель (+местонахождение), поставщик, страна
 * происхождения, гарантия, цена (BYN), признак б/у. Плюс продающие поля:
 * фото, галерея, характеристики, бейдж, кнопка заказа.
 *
 * Гибкие блоки контента рендерятся через `ContentBlocks.astro`.
 */
import { getCollection, getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentBlocks from '../../components/blocks/ContentBlocks.astro';
import { resolveImage } from '../../lib/image';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const p = product.data;

const lines = await getCollection('lines');
const line = lines.find((l) => l.id === p.line);

const settings = await getEntry('site', 'settings');
const brand = settings?.data.brand ?? 'Kiberstol.by';

const title = p.seo?.title ?? p.title;
const description = p.seo?.description ?? p.shortDescription;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kiberstol.by';
const productUrl = `${siteUrl}/products/${product.id}`;

const resolvedProductImage = resolveImage(p.image);
const productImageUrl = resolvedProductImage
  ? (await getImage({ src: resolvedProductImage, width: 1200, format: 'webp' })).src
  : undefined;

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.title,
  ...(description && { description }),
  url: productUrl,
  ...(productImageUrl && { image: `${siteUrl}${productImageUrl}` }),
  ...(brand && { brand: { '@type': 'Brand', name: brand } }),
  ...(p.countryOfOrigin && {
    countryOfOrigin: { '@type': 'Country', name: p.countryOfOrigin },
  }),
  offers: {
    '@type': 'Offer',
    price: p.price,
    priceCurrency: 'BYN',
    availability: 'https://schema.org/InStock',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Каталог', item: `${siteUrl}/products` },
    ...(line
      ? [{ '@type': 'ListItem', position: 3, name: line.data.title, item: `${siteUrl}/lines/${line.id}` }]
      : []),
    { '@type': 'ListItem', position: line ? 4 : 3, name: p.title, item: productUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={p.image}
  imageAlt={p.title}
  type="product"
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <nav class="mb-6 text-sm text-muted" aria-label="Хлебные крошки">
      <a href="/" class="hover:text-primary">Главная</a>
      <span class="mx-2">/</span>
      <a href="/products" class="hover:text-primary">Каталог</a>
      {line && (
        <>
          <span class="mx-2">/</span>
          <a href={`/lines/${line.id}`} class="hover:text-primary">{line.data.title}</a>
        </>
      )}
      <span class="mx-2">/</span>
      <span class="text-text">{p.title}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Фото и галерея -->
      <div>
        {resolveImage(p.image) && (
          <Image
            src={resolveImage(p.image)!}
            alt={p.title}
            width={1200}
            format="webp"
            class="w-full rounded border border-border object-cover"
          />
        )}
        {p.gallery && p.gallery.length > 0 && (
          <div class="mt-3 grid grid-cols-3 gap-3">
            {p.gallery.map((img, i) => (
              resolveImage(img) && (
                <Image
                  src={resolveImage(img)!}
                  alt={`${p.title} — фото ${i + 1}`}
                  width={400}
                  format="webp"
                  loading="lazy"
                  class="h-24 w-full rounded border border-border object-cover"
                />
              )
            ))}
          </div>
        )}
      </div>

      <!-- Основная информация -->
      <div>
        {p.badge && (
          <span class="mb-2 inline-block rounded bg-secondary px-2 py-0.5 text-xs font-semibold text-bg">
            {p.badge}
          </span>
        )}
        <h1 class="text-3xl font-bold text-text">{p.title}</h1>
        {p.shortDescription && <p class="mt-2 text-muted">{p.shortDescription}</p>}

        <div class="mt-4 flex items-baseline gap-3">
          <span class="text-3xl font-bold text-primary">
            {p.price.toLocaleString('ru-BY')} BYN
          </span>
          {p.oldPrice && (
            <span class="text-lg text-muted line-through">
              {p.oldPrice.toLocaleString('ru-BY')} BYN
            </span>
          )}
        </div>

        {p.ctaText && (
          <a
            href="#order-form"
            class="mt-6 inline-block rounded bg-primary px-6 py-3 font-semibold text-bg transition hover:opacity-90"
          >
            {p.ctaText}
          </a>
        )}

        {product.body && (
          <p class="mt-6 text-muted">{product.body}</p>
        )}
      </div>
    </div>

    <!-- Характеристики -->
    {p.specs && p.specs.length > 0 && (
      <div class="mt-10">
        <h2 class="mb-4 text-2xl font-bold text-text">Характеристики</h2>
        <div class="overflow-hidden rounded border border-border">
          <table class="w-full text-sm">
            <tbody>
              {
                p.specs.map((spec) => (
                  <tr class="border-b border-border last:border-b-0">
                    <th
                      scope="row"
                      class="w-1/3 bg-surface px-4 py-3 text-left font-semibold text-text"
                    >
                      {spec.name}
                    </th>
                    <td class="px-4 py-3 text-muted">{spec.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Юридически обязательные сведения о товаре -->
    <div class="mt-10 rounded border border-border bg-surface p-5">
      <h2 class="mb-4 text-xl font-bold text-text">Сведения о товаре</h2>
      <dl class="space-y-2 text-sm">
        <div>
          <dt class="font-semibold text-text">Изготовитель</dt>
          <dd class="text-muted">{p.manufacturer}{p.manufacturerLocation ? `, ${p.manufacturerLocation}` : ''}</dd>
        </div>
        <div>
          <dt class="font-semibold text-text">Поставщик</dt>
          <dd class="text-muted">{p.supplier}</dd>
        </div>
        <div>
          <dt class="font-semibold text-text">Страна происхождения</dt>
          <dd class="text-muted">{p.countryOfOrigin}</dd>
        </div>
        {p.warranty && (
          <div>
            <dt class="font-semibold text-text">Гарантийный срок</dt>
            <dd class="text-muted">{p.warranty}</dd>
          </div>
        )}
        {p.used && (
          <div>
            <dt class="font-semibold text-text">Состояние</dt>
            <dd class="text-muted">Товар, бывший в употреблении</dd>
          </div>
        )}
      </dl>
    </div>

    <!-- Гибкие блоки контента -->
    {p.content && p.content.length > 0 && (
      <div class="mt-10">
        <ContentBlocks blocks={p.content} />
      </div>
    )}
  </section>
</BaseLayout>