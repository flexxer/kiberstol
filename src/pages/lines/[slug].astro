---
/**
 * lines/[slug].astro — страница линейки (generic).
 *
 * Строится из гибких блоков контента (`content` → `ContentBlocks.astro`)
 * + список моделей линейки. Данные — из CMS (`lines/*.md`, `products/*.md`).
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentBlocks from '../../components/blocks/ContentBlocks.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import BreadcrumbList from '../../components/seo/jsonld/BreadcrumbList.astro';
import ItemList from '../../components/seo/jsonld/ItemList.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import { resolveImage } from '../../lib/image';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const lines = await getCollection('lines');
  return lines.map((line) => ({ params: { slug: line.id }, props: { line } }));
}

const { line } = Astro.props;

const products = (await getCollection('products'))
  .filter((p) => p.data.line === line.id)
  .sort((a, b) => a.data.order - b.data.order);

const settings = await getEntry('site', 'settings');
const labels = settings!.data.labels;

const title = line.data.seo?.title ?? line.data.title;
const description = line.data.seo?.description ?? line.body ?? '';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kiberstol.by';
---

<BaseLayout
  title={title}
  description={description}
  image={line.data.image}
  imageAlt={line.data.title}
  noindex={line.data.seo?.noindex}
  type="website"
>
  <BreadcrumbList
    slot="head"
    items={[
      { name: labels?.breadcrumbsHome ?? 'Главная', url: siteUrl },
      { name: labels?.breadcrumbsCatalog ?? 'Каталог', url: `${siteUrl}/products` },
      { name: line.data.title, url: `${siteUrl}/lines/${line.id}` },
    ]}
  />
  <ItemList
    slot="head"
    items={products.map((product, i) => ({
      name: product.data.title,
      url: `${siteUrl}/products/${product.id}`,
      position: i + 1,
    }))}
  />
  <section class="mx-auto max-w-6xl px-4 py-12">
    <Breadcrumbs
      items={[
        { name: labels?.breadcrumbsHome ?? 'Главная', url: '/' },
        { name: labels?.breadcrumbsCatalog ?? 'Каталог', url: '/products' },
        { name: line.data.title },
      ]}
    />

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center">
      {resolveImage(line.data.image) && (
        <Image
          src={resolveImage(line.data.image)!}
          alt={line.data.title}
          width={192}
          format="webp"
          class="h-24 w-24 rounded border border-border object-cover"
        />
      )}
      <div>
        <h1 class="text-3xl font-bold text-text">{line.data.title}</h1>
        {line.body && (
          <div class="prose prose-invert mt-2 max-w-3xl text-muted" set:html={renderMarkdown(line.body)} />
        )}
      </div>
    </div>

    {line.data.features && line.data.features.length > 0 && (
      <ul class="mb-8 space-y-1 text-sm text-muted">
        {line.data.features.map((f) => <li>• {f}</li>)}
      </ul>
    )}

    <ContentBlocks blocks={line.data.content} />

    {products.length > 0 && (
      <div class="mt-12">
        <h2 class="mb-4 text-2xl font-bold text-text">
          {labels?.lineModels ?? 'Модели линейки'}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            products.map((product) => (
              <ProductCard product={product} />
            ))
          }
        </div>
      </div>
    )}
  </section>
</BaseLayout>