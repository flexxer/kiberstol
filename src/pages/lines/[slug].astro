---
/**
 * lines/[slug].astro — страница линейки (generic).
 *
 * Строится из гибких блоков контента (`content` → `ContentBlocks.astro`)
 * + список моделей линейки. Данные — из CMS (`lines/*.md`, `products/*.md`).
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentBlocks from '../../components/blocks/ContentBlocks.astro';
import { resolveImage } from '../../lib/image';

export async function getStaticPaths() {
  const lines = await getCollection('lines');
  return lines.map((line) => ({ params: { slug: line.id }, props: { line } }));
}

const { line } = Astro.props;

const products = (await getCollection('products'))
  .filter((p) => p.data.line === line.id)
  .sort((a, b) => a.data.order - b.data.order);

const settings = await getEntry('site', 'settings');
const brand = settings?.data.brand ?? 'Kiberstol.by';

const title = line.data.seo?.title ?? line.data.title;
const description = line.data.seo?.description ?? line.body ?? '';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kiberstol.by';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Каталог', item: `${siteUrl}/products` },
    { '@type': 'ListItem', position: 3, name: line.data.title, item: `${siteUrl}/lines/${line.id}` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={line.data.image}
  imageAlt={line.data.title}
  type="website"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <nav class="mb-6 text-sm text-muted" aria-label="Хлебные крошки">
      <a href="/" class="hover:text-primary">Главная</a>
      <span class="mx-2">/</span>
      <a href="/products" class="hover:text-primary">Каталог</a>
      <span class="mx-2">/</span>
      <span class="text-text">{line.data.title}</span>
    </nav>

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center">
      {resolveImage(line.data.image) && (
        <Image
          src={resolveImage(line.data.image)!}
          alt={line.data.title}
          width={192}
          format="webp"
          class="h-24 w-24 rounded border border-border object-cover"
        />
      )}
      <div>
        <h1 class="text-3xl font-bold text-text">{line.data.title}</h1>
        {line.body && (
          <p class="mt-2 max-w-3xl text-muted">{line.body}</p>
        )}
      </div>
    </div>

    {line.data.features && line.data.features.length > 0 && (
      <ul class="mb-8 space-y-1 text-sm text-muted">
        {line.data.features.map((f) => <li>• {f}</li>)}
      </ul>
    )}

    <ContentBlocks blocks={line.data.content} />

    {products.length > 0 && (
      <div class="mt-12">
        <h2 class="mb-4 text-2xl font-bold text-text">Модели линейки</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            products.map((product) => (
              <a
                href={`/products/${product.id}`}
                class="group block overflow-hidden rounded border border-border bg-surface transition hover:border-primary"
              >
                {resolveImage(product.data.image) && (
                  <Image
                    src={resolveImage(product.data.image)!}
                    alt={product.data.title}
                    width={640}
                    format="webp"
                    loading="lazy"
                    class="h-40 w-full object-cover"
                  />
                )}
                <div class="p-4">
                  {product.data.badge && (
                    <span class="mb-2 inline-block rounded bg-secondary px-2 py-0.5 text-xs font-semibold text-bg">
                      {product.data.badge}
                    </span>
                  )}
                  <h3 class="font-semibold text-text group-hover:text-primary">
                    {product.data.title}
                  </h3>
                  <p class="mt-2 font-bold text-primary">
                    {product.data.price.toLocaleString('ru-BY')} BYN
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    )}
  </section>
</BaseLayout>