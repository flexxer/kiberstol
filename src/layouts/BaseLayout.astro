---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getEntry } from 'astro:content';
import SEO from '../components/seo/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
  keywords?: string[];
}

const {
  title,
  description,
  image,
  imageAlt,
  canonical,
  noindex,
  type,
  keywords,
} = Astro.props;

// Идентификаторы аналитики/рекламы — из `site/settings.yaml` (единый источник правды).
// Передаются на клиент через data-атрибуты <body> и подставляются в
// analytics.ts / advertising.ts только после согласия пользователя.
const settings = await getEntry('site', 'settings');
const analytics = settings?.data.analytics;
const advertising = settings?.data.advertising;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#00d4ff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonical={canonical}
      noindex={noindex}
      type={type}
      keywords={keywords}
    />

    <ClientRouter />

    <!-- Слот для JSON-LD компонентов (Organization, Product, ItemList, …) -->
    <slot name="head" />
  </head>
  <body
    data-ga4-id={analytics?.ga4Id}
    data-yandex-metrika-id={analytics?.yandexMetrikaId}
    data-google-ads-id={advertising?.googleAdsId}
    data-yandex-direct-id={advertising?.yandexDirectId}
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Cookie-баннер (гранулярное согласие: аналитика / маркетинг).
         Скрыт по умолчанию (`hidden`), чтобы не было FOUC; показывается из
         cookie-consent.ts, если решение ещё не принято. -->
    <div
      id="cookie-banner"
      class="fixed bottom-0 left-0 right-0 z-[90] border-t border-border bg-surface p-4 shadow-lg"
      role="dialog"
      aria-label="Согласие на использование cookie"
      hidden
    >
      <div class="mx-auto max-w-6xl">
        <p class="mb-3 text-sm text-muted">
          Мы используем cookie для аналитики и рекламы. Вы можете выбрать,
          какие категории разрешить. Подробнее — в{' '}
          <a href="/cookie-policy" class="text-primary hover:underline">политике cookie</a>.
        </p>
        <div class="mb-3 flex flex-col gap-2 text-sm sm:flex-row sm:gap-6">
          <label class="flex items-center gap-2 text-text">
            <input type="checkbox" name="consent-analytics" />
            Аналитика
          </label>
          <label class="flex items-center gap-2 text-text">
            <input type="checkbox" name="consent-marketing" />
            Реклама
          </label>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            data-consent="accept-all"
            class="rounded bg-primary px-4 py-2 text-sm font-semibold text-bg transition hover:opacity-90"
          >
            Принять всё
          </button>
          <button
            type="button"
            data-consent="reject-all"
            class="rounded border border-border px-4 py-2 text-sm text-text transition hover:bg-bg"
          >
            Отказаться
          </button>
          <button
            type="button"
            data-consent="save"
            class="rounded border border-border px-4 py-2 text-sm text-text transition hover:bg-bg"
          >
            Сохранить выбор
          </button>
        </div>
      </div>
    </div>

    <script>
      import { initPage } from '../scripts/app';

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>