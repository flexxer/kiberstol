# ============================================================================
# Переменные окружения Kiberstol.by
# Скопируйте в `.env` (он в .gitignore). Секреты НЕ коммитятся.
# Для PHP-обработчика формы используйте getenv() — переменные читаются
# только на сервере и никогда не попадают в клиентский бандл.
# ============================================================================

# --- Telegram (public/api/submit.php) ---------------------------------------
# Токен и chat_id хранятся ТОЛЬКО в окружении сервера/хостинга.
TG_BOT_TOKEN=
TG_CHAT_ID=

# 1 — не отправлять в Telegram: валидация, лог и 200 {ok:true,dryRun:true}.
TG_DRY_RUN=0

# Список origin через запятую. По умолчанию https://kiberstol.by.
# Для локальной проверки: http://127.0.0.1:8080,http://localhost:8080
ALLOWED_ORIGINS=

# Доверенные прокси (IP/CIDR) для чтения X-Forwarded-For. Только при реальном прокси.
TRUSTED_PROXIES=

# Версия согласия на обработку ПД, фиксируется в заявке.
FORM_CONSENT_VERSION=1

# Опциональный лог заявок вне webroot (содержит ПД — ограничьте права доступа).
LEADS_LOG_PATH=

# Каталог счётчиков rate limit. По умолчанию sys_get_temp_dir().
RATE_LIMIT_DIR=

# Переопределение базового URL Telegram Bot API. Только для тестов/диагностики.
# В production оставьте пустым (по умолчанию https://api.telegram.org).
TG_API_BASE=

# --- Keystatic CMS -----------------------------------------------------------
# local — для разработки, github — для production (git-based CMS, GitHub OAuth).
PUBLIC_KEYSTATIC_STORAGE=local
PUBLIC_KEYSTATIC_GITHUB_REPO_OWNER=
PUBLIC_KEYSTATIC_GITHUB_REPO_NAME=

# GitHub OAuth / GitHub App для Keystatic (только сервер, не коммитятся).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
