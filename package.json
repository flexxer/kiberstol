{
  "name": "kiberstol",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "validate:content": "tsx scripts/validate-content.ts",
    "import:products": "node scripts/import-products.mjs",
    "serve:php": "node scripts/serve-php.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "lint:php": "php -l public/api/submit.php",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "audit:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:og": "node scripts/generate-og-default.mjs",
    "generate:assets": "npm run generate:brand && npm run generate:og",
    "generate:client-pdf": "node scripts/generate-client-pdf.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  }
